pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
cls(3)
pal(4,0)
function _init()
lives=3
wait=0
btnz=false
level=1
zombies={}
buls={}
plantline=1
btnu=false
btnd=false
kills=0
t=0
lineys={20,50,80}
plant={x=10,y=lineys[plantline]}
end

function _update()
wait-=1

if wait<0 then
t+=1
if btnp(🅾️) then
btnz=true
end
if btnp(⬆️) then
btnu=true
end
if btnp(⬇️) then
btnd=true
end


updategame()
end


end




function _draw()
fillp(0b0011001111001100)
cls(3)
pal(0,3)
rectfill(0,0,127,127,11)
pal(4,0)
spr(1,plant.x,lineys[plantline],2,2)
for bul in all(buls) do
spr(3,bul.x,bul.y)
end
for zmb in all(zombies) do
spr(33,zmb.x,zmb.y,2,2)
end
drawui()
print(wait,2,2,8)
end
-->8
--game
function updategame()
makezombie()
zombieshoot()
for en in all(zombies) do
if t%10==0 then
en.x-=8
end
if en.x<plant.x+15 then
lives-=1
del(zombies,en)
end
end
for i in all(buls) do
i.x+=3
if i.x>136 then
del(buls,i)
end
end
if btnu==true and plantline!=1 then
plantline-=1
end
if btnd==true and plantline!=3 then
plantline+=1
end

if btnz==true then
makebul()
end


btnz=false
btnu=false
btnd=false
end

function makebul()

local bul={}
bul.x=plant.x+17
bul.y=lineys[plantline]+3
bul.line=plantline
for i in all(buls) do
if i.line==bul.line then
return
end

end
add(buls,bul)
sfx(0)
end


function makezombie()
local zomb={}
zomb.x=100
zomb.hp=2
zomb.line=flr(rnd(3))+1
zomb.y=lineys[zomb.line]
for i in all(zombies) do
if i.line==zomb.line or #zombies>=level then
return
end

end
add(zombies,zomb)
end

function zombieshoot()
for bul in all(buls) do
for en in all(zombies) do
if bul.x>=en.x-8 and bul.line==en.line then
sfx(1)
del(buls,bul)
en.hp-=1
if en.hp<=0 then
del(zombies,en)
del(buls,bul)
kills+=1
if kills==50 then
level=3
wait=30
sfx(2)
elseif kills==20 then
level=2
wait=30
sfx(2)
end
end

end
end
end
end
-->8
function drawui()
for i=1,lives do
spr(9,i*8,120)

end
end
